rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function currentUserData() {
      return userData(request.auth.uid);
    }

    function role() {
      return isSignedIn() ? currentUserData().get('role', 'customer') : 'customer';
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isConsultant() {
      return isSignedIn() && role() == 'consultant';
    }

    function isActiveConsultant() {
      return isConsultant() && currentUserData().get('isActive', true) == true;
    }

    function isPremiumUser() {
      return isSignedIn() && currentUserData().get('isPremium', false) == true;
    }

    function isContentPremium(data) {
      return data.get('isPremium', false) == true || data.get('premiumOnly', false) == true;
    }

    function isValidCustomerCreate(uid) {
      return isOwner(uid)
        && request.resource.data.get('role', 'customer') == 'customer'
        && request.resource.data.get('isActive', true) == true
        && request.resource.data.get('isPremium', false) == false
        && request.resource.data.get('email', '') == request.auth.token.email;
    }

    function customerProfileFieldsUnchanged() {
      return request.resource.data.get('role', resource.data.get('role', 'customer')) == resource.data.get('role', 'customer')
        && request.resource.data.get('isActive', resource.data.get('isActive', true)) == resource.data.get('isActive', true)
        && request.resource.data.get('isPremium', resource.data.get('isPremium', false)) == resource.data.get('isPremium', false)
        && request.resource.data.get('email', resource.data.get('email', '')) == resource.data.get('email', '');
    }

    function isOwnAssignedConsultation() {
      return isActiveConsultant()
        && resource.data.get('assignedConsultantId', null) == request.auth.uid;
    }

    function canReadConsultation(userId) {
      return isOwner(userId)
        || isAdmin()
        || isOwnAssignedConsultation()
        || (isActiveConsultant()
          && resource.data.get('assignedConsultantId', null) == null
          && resource.data.get('status', '') in ['open', 'waiting_for_consultant']);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isValidCustomerCreate(userId) || isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && customerProfileFieldsUnchanged());
      allow delete: if isAdmin();

      match /analysis/{analysisId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.get('userId', userId) == userId;
        allow update, delete: if isAdmin();
      }

      match /wardrobe/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.get('userId', userId) == userId;
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      match /preferences/{prefId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin()
          || (isOwner(userId)
            && request.resource.data.get('read', false) == false
            && request.resource.data.get('title', '') is string
            && request.resource.data.get('body', '') is string
            && request.resource.data.get('type', 'system') is string);
        allow update: if isAdmin()
          || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    match /content/{contentId} {
      allow create, update, delete: if isAdmin();
      allow get: if isAdmin() || (
        isSignedIn()
        && resource.data.get('isPublished', false) == true
        && (!isContentPremium(resource.data) || isPremiumUser())
      );
      allow list: if isAdmin() || (
        isSignedIn()
        && resource.data.get('isPublished', false) == true
        && (!isContentPremium(resource.data) || isPremiumUser())
      );
    }

    match /forum_posts/{postId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.get('authorId', '') == request.auth.uid
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('body', '') is string
        && request.resource.data.get('category', '') is string
        && request.resource.data.get('isOfficial', false) == false;
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.get('authorId', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'category', 'updatedAt']))
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastActivityAt'])
          && request.resource.data.get('commentCount', 0) == resource.data.get('commentCount', 0) + 1)
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'lastActivityAt'])
          && (
            (request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) + 1
              && getAfter(/databases/$(database)/documents/forum_posts/$(postId)/likes/$(request.auth.uid)).exists())
            || (request.resource.data.get('likeCount', 0) == resource.data.get('likeCount', 0) - 1
              && !getAfter(/databases/$(database)/documents/forum_posts/$(postId)/likes/$(request.auth.uid)).exists())
          ));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.get('authorId', '') == request.auth.uid);

      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.get('authorId', '') == request.auth.uid
          && request.resource.data.get('body', '') is string;
        allow update: if isAdmin()
          || (isSignedIn()
            && resource.data.get('authorId', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt']));
        allow delete: if isAdmin() || (isSignedIn() && resource.data.get('authorId', '') == request.auth.uid);
      }

      match /likes/{userId} {
        allow get, list: if isSignedIn();
        allow create: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt']);
        allow delete: if isOwner(userId);
        allow update: if false;
      }
    }

    match /consultations/{userId} {
      allow get: if canReadConsultation(userId);
      allow list: if isAdmin()
        || (isActiveConsultant()
          && (resource.data.get('assignedConsultantId', null) == request.auth.uid
            || (resource.data.get('assignedConsultantId', null) == null
              && resource.data.get('status', '') in ['open', 'waiting_for_consultant'])));
      allow create: if isOwner(userId)
        && request.resource.data.get('uid', userId) == userId
        && request.resource.data.get('assignedConsultantId', null) == null;

      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.get('uid', userId) == userId
          && request.resource.data.get('assignedConsultantId', null) == resource.data.get('assignedConsultantId', null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid', 'userName', 'email', 'status', 'lastMessage', 'lastSenderType',
            'unreadForConsultant', 'updatedAt'
          ])
          && request.resource.data.get('status', '') == 'waiting_for_consultant'
          && request.resource.data.get('lastSenderType', '') == 'user')
        || (isOwner(userId)
          && resource.data.get('status', '') == 'resolved'
          && request.resource.data.get('status', '') == 'waiting_for_consultant'
          && request.resource.data.get('assignedConsultantId', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'lastMessage', 'lastSenderType', 'unreadForConsultant',
            'resolvedAt', 'assignedConsultantId', 'assignedConsultantName',
            'firstConsultantReplyAt', 'responseTimeSeconds', 'rating',
            'ratingComment', 'ratedAt', 'updatedAt'
          ])
          && request.resource.data.get('lastSenderType', '') == 'user')
        || (isOwner(userId)
          && resource.data.get('status', '') == 'resolved'
          && request.resource.data.get('status', '') == 'resolved'
          && request.resource.data.get('assignedConsultantId', null) == resource.data.get('assignedConsultantId', null)
          && resource.data.get('rating', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingComment', 'ratedAt'])
          && request.resource.data.get('rating', 0) is int
          && request.resource.data.get('rating', 0) >= 1
          && request.resource.data.get('rating', 0) <= 5)
        || (isActiveConsultant()
          && resource.data.get('assignedConsultantId', null) == null
          && resource.data.get('status', '') in ['open', 'waiting_for_consultant']
          && request.resource.data.get('assignedConsultantId', null) == request.auth.uid
          && request.resource.data.get('status', '') == 'assigned'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'assignedConsultantId', 'assignedConsultantName', 'status', 'assignedAt', 'updatedAt'
          ]))
        || (isOwnAssignedConsultation()
          && request.resource.data.get('assignedConsultantId', null) == request.auth.uid
          && request.resource.data.get('status', '') in ['assigned', 'consultant_replied', 'resolved']
          && request.resource.data.get('lastSenderType', '') == 'consultant'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'lastMessage', 'lastSenderType', 'unreadForUser',
            'unreadForConsultant', 'firstConsultantReplyAt', 'responseTimeSeconds',
            'resolvedAt', 'updatedAt', 'assignedConsultantId', 'assignedConsultantName',
            'assignedAt'
          ]));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(userId) || isAdmin() || isOwnAssignedConsultation();
        allow create: if (isOwner(userId)
            && request.resource.data.get('senderType', '') == 'user'
            && request.resource.data.get('senderId', '') == request.auth.uid)
          || (isOwnAssignedConsultation()
            && request.resource.data.get('senderType', '') == 'consultant'
            && request.resource.data.get('senderId', '') == request.auth.uid);
        allow update: if isAdmin()
          || (isOwner(userId)
            && resource.data.get('senderType', '') == 'consultant'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
          || (isOwnAssignedConsultation()
            && resource.data.get('senderType', '') == 'user'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
        allow delete: if isAdmin();
      }
    }

    match /consultant_presence/{consultantId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isActiveConsultant() && request.auth.uid == consultantId;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
